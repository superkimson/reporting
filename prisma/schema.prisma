// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Platform {
  INSTAGRAM
  FACEBOOK
  YOUTUBE
  TIKTOK
}

enum PeriodType {
  WEEKLY
  MONTHLY
}

// Une saisie de statistiques pour un réseau et une période donnés.
// Les champs spécifiques à certains réseaux (ex: watchTime pour YouTube/TikTok)
// sont nullable plutôt que d'avoir un modèle par réseau.
model Entry {
  id         String     @id @default(cuid())
  platform   Platform
  periodType PeriodType
  periodDate DateTime

  followers      Int
  impressions    Int
  engagements    Int
  engagementRate Float?

  watchTimeMinutes Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([platform, periodType, periodDate])
  @@index([platform])
  @@index([periodDate])
}
