// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Platform {
  INSTAGRAM
  FACEBOOK
  TIKTOK
  WHATSAPP
  YOUTUBE
  DAILYMOTION
}

// Chaque réseau a deux pages distinctes selon l'édition (marché FR vs NL).
enum Edition {
  MA
  AG
}

enum PeriodType {
  WEEKLY
  MONTHLY
}

// Une saisie de statistiques pour un réseau, une édition et une période donnés.
// Seuls Instagram, Facebook et TikTok suivent la portée ; elle est nullable
// puisqu'elle ne s'applique pas aux autres réseaux (YouTube, Dailymotion, WhatsApp).
model Entry {
  id         String     @id @default(cuid())
  platform   Platform
  edition    Edition
  periodType PeriodType
  periodDate DateTime

  followers Int
  views     Int
  reach     Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([platform, edition, periodType, periodDate])
  @@index([platform])
  @@index([edition])
  @@index([periodDate])
}

// Les 5 vidéos les plus vues du mois (tous réseaux confondus), avec leur
// miniature. Pas de notion d'édition MA/AG ici — un seul Top 5 par mois.
model TopFiveEntry {
  id         String   @id @default(cuid())
  periodDate DateTime // toujours ramené au 1er du mois
  position   Int // 1 à 5, un emplacement par colonne dans l'UI
  name       String
  views      Int
  // Image encodée en data URL ("data:image/jpeg;base64,...") — stockée
  // directement en base, pas de service de fichiers dédié.
  imageData  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([periodDate, position])
  @@index([periodDate])
}
