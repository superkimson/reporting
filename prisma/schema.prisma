// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Platform {
  INSTAGRAM
  FACEBOOK
  TIKTOK
  WHATSAPP
  YOUTUBE
  DAILYMOTION
}

// Chaque réseau a deux pages distinctes selon l'édition (marché FR vs NL).
enum Edition {
  MA
  AG
}

enum PeriodType {
  WEEKLY
  MONTHLY
}

// Une saisie de statistiques pour un réseau, une édition et une période donnés.
// Seuls Instagram, Facebook et TikTok suivent la portée ; elle est nullable
// puisqu'elle ne s'applique pas aux autres réseaux (YouTube, Dailymotion, WhatsApp).
model Entry {
  id         String     @id @default(cuid())
  platform   Platform
  edition    Edition
  periodType PeriodType
  periodDate DateTime

  followers Int
  views     Int
  reach     Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([platform, edition, periodType, periodDate])
  @@index([platform])
  @@index([edition])
  @@index([periodDate])
}
