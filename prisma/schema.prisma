// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Platform {
  INSTAGRAM
  FACEBOOK
  TIKTOK
  WHATSAPP
  YOUTUBE
  DAILYMOTION
}

// Chaque réseau a deux pages distinctes selon l'édition (marché FR vs NL).
enum Edition {
  MA
  AG
}

enum PeriodType {
  WEEKLY
  MONTHLY
}

// Une saisie de statistiques pour un réseau, une édition et une période donnés.
// YouTube et Dailymotion n'ont que followers/views ; reach et interactions
// sont nullable puisqu'ils ne s'appliquent qu'aux autres réseaux.
model Entry {
  id         String     @id @default(cuid())
  platform   Platform
  edition    Edition
  periodType PeriodType
  periodDate DateTime

  followers      Int
  views          Int
  reach          Int?
  interactions   Int?
  engagementRate Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([platform, edition, periodType, periodDate])
  @@index([platform])
  @@index([edition])
  @@index([periodDate])
}
